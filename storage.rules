rules_version = '2';
// Receipts are only written/read by Cloud Functions (Admin SDK bypasses these
// rules). Keep public client access denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{userId}/{allPaths=**} {
      allow read, write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
